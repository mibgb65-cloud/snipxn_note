# Spring profile
APP_ENV=dev

# Server
SERVER_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5432/snipxn_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=10s

# Flyway
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Mail
MAIL_API_KEY=
MAIL_FROM=

# RabbitMQ email retry
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_MS=30000
