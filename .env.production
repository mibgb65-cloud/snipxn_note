# ===== Snipxn Production Environment =====
# Copy this file to .env and fill in actual values before deploying
# Required fields are marked with [REQUIRED]

# ---- Database ----
DB_NAME=snipxn
DB_USER=snipxn
DB_PASSWORD=CHANGE_ME_DB_PASSWORD          # [REQUIRED]

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD    # [REQUIRED]

# ---- RabbitMQ ----
RABBITMQ_USER=snipxn
RABBITMQ_PASSWORD=CHANGE_ME_MQ_PASSWORD    # [REQUIRED]

# ---- JWT ----
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING    # [REQUIRED] min 32 chars

# ---- CORS ----
# Set to your actual domain, e.g. https://snipxn.com
CORS_ALLOWED_ORIGINS=https://snipxn.com,https://www.snipxn.com

# ---- Mail (Resend) ----
MAIL_API_KEY=
MAIL_FROM=noreply@snipxn.com

# ---- OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Sandbox (Judge0) ----
JUDGE0_URL=
JUDGE0_API_KEY=

# ---- AI (DeepSeek) ----
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- JVM ----
JAVA_OPTS=-Xms256m -Xmx512m
